{
  "name": "photon-grid-core",
  "version": "3.0.11",
  "description": "Professional zero-dependency TypeScript data grid with enterprise-grade features.",
  "author": "Abdul Wahid",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/photon-grid.min.js",
  "jsdelivr": "./dist/photon-grid.min.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./import/sheetjs": {
      "types": "./dist/engines/import/adapters/sheetjs-workbook-parser.d.ts",
      "import": "./dist/engines/import/adapters/sheetjs-workbook-parser.js",
      "default": "./dist/engines/import/adapters/sheetjs-workbook-parser.js"
    },
    "./export/excel": {
      "types": "./dist/export/excel.d.ts",
      "import": "./dist/export/excel.js",
      "default": "./dist/export/excel.js"
    },
    "./export/register-excel": {
      "types": "./dist/export/register-excel.d.ts",
      "import": "./dist/export/register-excel.js",
      "default": "./dist/export/register-excel.js"
    },
    "./export/pdf": {
      "types": "./dist/export/pdf.d.ts",
      "import": "./dist/export/pdf.js",
      "default": "./dist/export/pdf.js"
    },
    "./styles/*": "./styles/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "styles",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css",
    "styles/*.css"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && tsc && npm run build:cjs && npm run build:cdn && node scripts/make-dist-pkg.mjs",
    "build:cjs": "esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=dist/index.cjs",
    "build:cdn": "esbuild src/index.ts --bundle --minify --platform=browser --target=es2020 --format=iife --global-name=PhotonGrid --outfile=dist/photon-grid.min.js",
    "build:watch": "tsc --project tsconfig.json --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "demo": "esbuild demo/demo.ts --bundle --outfile=demo/demo.bundle.js --format=iife --global-name=PhotonGridDemo --target=es2020 --platform=browser --sourcemap",
    "demo:inventory": "esbuild demo/inventory-demo.ts --bundle --outfile=demo/inventory-demo.bundle.js --format=iife --global-name=PhotonGridInventoryDemo --target=es2020 --platform=browser --sourcemap",
    "demo:tree": "esbuild demo/tree-data-demo.ts --bundle --outfile=demo/tree-data-demo.bundle.js --format=iife --global-name=PhotonGridTreeDemo --target=es2020 --platform=browser --sourcemap",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "grid",
    "data-grid",
    "datatable",
    "table",
    "spreadsheet",
    "excel",
    "tree-grid",
    "virtual-scroll",
    "virtualization",
    "typescript",
    "javascript",
    "ui",
    "enterprise-grid",
    "performance",
    "zero-dependency"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abdulwahid-csit/photon-grid.git"
  },
  "homepage": "https://github.com/abdulwahid-csit/photon-grid#readme",
  "bugs": {
    "url": "https://github.com/abdulwahid-csit/photon-grid/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "xlsx": "*"
  },
  "peerDependenciesMeta": {
    "xlsx": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
